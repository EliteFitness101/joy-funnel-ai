# ── App ─────────────────────────────────────────────────────────────────────
APP_URL=https://reset.resofit.fit
VITE_APP_URL=https://reset.resofit.fit
MAKE_WEBHOOK_URL=https://hook.eu1.make.com/p0c26asklninfrxhp2sw6nkdjjb19a89
# Shared secret used by GitHub Actions to HMAC-sign the make.com webhook body.
# Generate with: openssl rand -hex 32
# Then paste the SAME value into:
#   1) GitHub → repo Settings → Secrets → Actions → MAKE_WEBHOOK_SECRET
#   2) make.com scenario → "Verify signature" step (HMAC-SHA256, header X-Signature)
MAKE_WEBHOOK_SECRET=GENERATE_WITH_openssl_rand_hex_32
NODE_ENV=production

# ── Preview-environment overrides (optional) ────────────────────────────────
# In Vercel you can set per-environment values. For Preview deployments, point
# APP_URL at the Vercel preview origin so emails/callbacks resolve correctly:
#   APP_URL=https://$VERCEL_URL
#   VITE_APP_URL=https://$VERCEL_URL
# (Vercel injects $VERCEL_URL automatically per deployment.)
